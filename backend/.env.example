# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Auth ---
JWT_SECRET=chaine-longue-aleatoire
JWT_EXPIRES=30d
BOOTSTRAP_SECRET=chaine-aleatoire

# --- Cron (facturation + relances) ---
CRON_SECRET=chaine-aleatoire

# --- Stripe (optionnel : paiement en ligne) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://locamp.onrender.com

# --- Brevo (optionnel : e-mails de relance) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Locamp

# PORT injecté par Render
# PORT=3000

# --- Portail locataire ---
# PORTAIL_DEV=true   # renvoie le lien magique dans la réponse si e-mail non configuré (tests uniquement)

# --- Éditeur du logiciel (attestation de conformité fiscale, art. 286-I-3° bis CGI) ---
# L'éditeur est la personne qui atteste et qui en répond, pas le camping.
LOCAMP_EDITEUR_NOM=
LOCAMP_EDITEUR_SIREN=
LOCAMP_EDITEUR_ADRESSE=
LOCAMP_EDITEUR_REPRESENTANT=
LOCAMP_EDITEUR_QUALITE=Président
LOCAMP_EDITEUR_VILLE=
